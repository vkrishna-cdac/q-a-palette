# Copy to .env for local development (vite dev picks it up automatically).
# In Docker, pass these as real environment variables instead (e.g. `docker run -e JWT_SECRET=...`).

# Required. Signs/verifies access-token JWTs — use a long random string, no default provided.
JWT_SECRET=

# Optional. Path to the SQLite database file. Defaults to ./data/app.db locally;
# the Docker image sets this to /app/data/app.db (see the VOLUME in Dockerfile).
DATABASE_PATH=./data/app.db
